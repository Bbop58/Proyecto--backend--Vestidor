# Environment Configuration
PROJECT_NAME="Sistema de Autenticacion"
API_V1_STR="/api/v1"
SECRET_KEY=REPLACE_WITH_A_PRIVATE_RANDOM_KEY_OF_AT_LEAST_32_CHARACTERS
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# PostgreSQL Database Connection
POSTGRES_SERVER=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=probando_1_db

# CORS Allowed Origins (Comma-separated)
BACKEND_CORS_ORIGINS=["http://localhost:4200","http://localhost:3000","http://127.0.0.1:4200","http://localhost:8000"]

# Normal startup does not mutate schema or seed demo data.
RUN_STARTUP_MIGRATIONS=false
RUN_DEMO_SEED=false

# Generate a private value locally: python -c "import secrets; print(secrets.token_urlsafe(48))"
# Privileged platform accounts must also belong to a company. Empty means no grants.
PLATFORM_ADMIN_USER_IDS=[]
